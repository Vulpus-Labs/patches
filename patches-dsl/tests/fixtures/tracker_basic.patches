pattern drums {
    kick: x . . . x . . .
}

pattern fill {
    kick: x x x x x x x x
}

song my_song(drums) {
    play {
        drums
        drums
        fill
    }
}

patch {
    module seq: MasterSequencer([drums]) {
        song: my_song,
        bpm: 120,
        rows_per_beat: 4,
        loop: false,
        autostart: true,
        swing: 0.5
    }
    module player: PatternPlayer([kick])
    module t2a: SyncToTrigger
    module join: StereoJoiner
    module out: AudioOut

    seq.clock[drums] -> player.clock
    player.trigger[kick] -> t2a.in
    t2a.out -> join.in_left
    player.cv1[kick] -> join.in_right
    join.out -> out.in
}
