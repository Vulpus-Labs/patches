// Any change here MUST also update patches-lsp/tree-sitter-patches/grammar.js
// AND add a corpus entry in patches-lsp/tests/syntax_corpus/*.corpus.
// The corpus driver enforces pest/tree-sitter parity.
//
// ─── Whitespace and comments ─────────────────────────────────────────────────
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "#" ~ (!"\n" ~ ANY)* }

// ─── Lexical atoms ────────────────────────────────────────────────────────────
ident      = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }
nat        = @{ ASCII_DIGIT+ }
// float must precede int so "440.0" is not consumed as just "440"
float_lit  = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* }
int_lit    = @{ "-"? ~ ASCII_DIGIT+ }
// Word-boundary lookahead prevents "trueish" matching as bool_lit
bool_lit   = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
string_lit = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

// Scale number inside arrow brackets (float or int, including negatives)
scale_num  = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? }

// ─── Unit-suffixed numeric literals ───────────────────────────────────────────
// kHz before Hz to prevent "kHz" matching as just "Hz" with a dangling "k".
// `c` = cents (N/1200 v/oct); `s` = semis (N/12 v/oct).
unit_suffix = @{ ^"khz" | ^"hz" | ^"db" | ^"c" | ^"s" }
// Number (possibly signed) immediately followed by a unit suffix (no whitespace).
// Trailing boundary prevents single-letter `c`/`s` from eating subsequent idents.
// The parser rejects negative/zero Hz and kHz; dB, cents, semis may be negative.
float_unit  = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? ~ unit_suffix ~ !(ASCII_ALPHANUMERIC | "_") }

// ─── Note name literals ───────────────────────────────────────────────────────
// Examples: C1  Bb2  A#-1  f#3  db0  (all case-insensitive)
// Octave is a signed integer; a word-boundary check prevents "C1foo" matching.
note_letter     = @{ ^"a" | ^"b" | ^"c" | ^"d" | ^"e" | ^"f" | ^"g" }
note_accidental = @{ "#" | ^"b" }
note_octave     = @{ "-"? ~ ASCII_DIGIT+ }
note_lit        = @{ note_letter ~ note_accidental? ~ note_octave ~ !(ASCII_ALPHANUMERIC | "_") }

// `<param_ref_ident>` template-parameter reference.
// Allows "/" so that group-param indexed keys like <level/0> are valid.
param_ref_ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-" | "/")* }
param_ref  = ${ "<" ~ param_ref_ident ~ ">" }

// ─── File reference ──────────────────────────────────────────────────────────
// `file("path/to/ir.wav")` — syntactically distinct from a plain string.
// The path may be a string literal or a <param> reference.
file_ref    = { "file" ~ "(" ~ (string_lit | param_ref) ~ ")" }

// ─── Value hierarchy ──────────────────────────────────────────────────────────
// Alternatives are ordered:
//   file_ref before ident (so "file(...)" is not consumed as a bare ident)
//   float_unit before float_lit/int_lit (so "440Hz" is not consumed as "440")
//   note_lit before ident (so "C1" is a note, not a bare string)
//   bool_lit before ident (existing; "true"/"false" have word-boundary check)
scalar      = { float_unit | float_lit | int_lit | bool_lit | note_lit | string_lit | param_ref | ident }
value       = { file_ref | scalar }

// ─── Module-call arg block ────────────────────────────────────────────────────
// alias_list: a bracketed list of identifiers; used in shape args to declare
// per-channel aliases.
//   [drums, bass, guitar]  →  AliasList(["drums", "bass", "guitar"])
alias_list  = { "[" ~ (ident ~ ","?)* ~ "]" }
// call_block: the parenthesised block on a module declaration.
// Carries either a shape value (positional `channels` for primitive modules)
// or template call args (named entries / shorthand `<ident>` / single
// positional value for one-param templates). Disambiguated semantically by
// the expander — see `crate::expand::binding`.
//
// Order matters: `named_arg` must come before `bare_arg` so `ident:` is not
// consumed as a bare scalar identifier. `shorthand_arg` must come before
// `bare_arg` so `<ident>` is recognised as shorthand.
named_arg     = { ident ~ ":" ~ (alias_list | scalar) }
shorthand_arg = { param_ref }
bare_arg      = { alias_list | scalar }
call_arg      = { named_arg | shorthand_arg | bare_arg }
call_block    = { "(" ~ (call_arg ~ ","?)* ~ ")" }

// param_index: literal index [N], arity wildcard [*ident], or alias [ident].
// Compound-atomic for arity to prevent whitespace between * and ident.
param_index_arity = ${ "*" ~ ident }
param_index       = { "[" ~ (param_index_arity | nat | ident) ~ "]" }

// param_entry: supports plain, indexed [N], and arity-wildcard [*n] forms.
//   pan: 0.0          → key "pan", no index
//   pan[0]: -0.5      → key "pan", index Literal(0)
//   pan[*size]: 0.0   → key "pan", index Arity("size") — expands over 0..size
//   @0: { freq: 200.0 }        → AtBlock, index Literal(0)
//   @low: { freq: 200.0 }      → AtBlock, index Alias("low")
at_block_index = { nat | ident }
at_block_body  = { "{" ~ (at_block_entry ~ ","?)* ~ "}" }
at_block_entry = { ident ~ ":" ~ value }
at_block       = { "@" ~ at_block_index ~ ":"? ~ at_block_body }
// param_entry rule: at_block must come before ident to ensure "@" is not parsed differently.
param_entry = { at_block | ident ~ param_index? ~ ":" ~ value }
// A param block item is either a shorthand `<ident>` or a regular `key: value`.
param_block = { "{" ~ ((param_ref | param_entry) ~ ","?)* ~ "}" }

// ─── Module declaration ───────────────────────────────────────────────────────
// Optional `stereo` prefix marks the module as stereo-paired (ADR 0070).
// Word-boundary lookahead prevents `stereo_in` from being consumed as the
// keyword (matches the `bool_lit` treatment). Side-specific params live
// inside the regular param block as `@l: { ... }` / `@r: { ... }` at_blocks
// (no new surface needed — at_block is already a valid ParamEntry); side
// selectors on ports reuse the existing `port[l]` / `port[r]` index form.
stereo_kw   = @{ "stereo" ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
module_decl = { stereo_kw? ~ "module" ~ ident ~ ":" ~ ident ~ call_block? ~ param_block? }

// ─── Port references ──────────────────────────────────────────────────────────
// Compound-atomic: no whitespace within "mod.port[k]"
module_ident = { "$" | ident }
// Port index — three forms:
//   [0]   → Literal(0)
//   [k]   → Param("k")   (bare ident in brackets; `port[l]` / `port[r]`
//                         on a stereo module are channel selectors —
//                         disambiguated by the expander against the
//                         declared module kind)
//   [*n]  → Arity("n")   (* followed by ident)
port_index_arity = ${ "*" ~ ident }
port_index       = ${ "[" ~ (port_index_arity | nat | param_ref | ident) ~ "]" }
// Port label: either a bare ident or a <param> reference
port_label   = ${ param_ref | ident }
port_ref     = ${ module_ident ~ "." ~ port_label ~ port_index? }

// ─── Arrows ───────────────────────────────────────────────────────────────────
// Compound-atomic: no whitespace inside "-[0.5]->" or "<-[0.5]-"
// Scale value: a unit literal, a plain numeric literal, or a <param> reference.
// float_unit comes first so `1s` is not consumed as `scale_num` "1".
// note_lit comes before scale_num so `C1` parses as a note, not a string.
scale_endpoint = ${ param_ref | float_unit | note_lit | scale_num }
range_kind     = @{ "uni" | "bi" }
range_ws       = _{ (" " | "\t")* }
scale_range    = ${ range_kind ~ "(" ~ range_ws ~ scale_endpoint ~ range_ws ~ "," ~ range_ws ~ scale_endpoint ~ range_ws ~ ")" }
scale_val      = ${ scale_range | scale_endpoint }
forward_arrow  = ${ ("-[" ~ scale_val ~ "]->") | "->" }
backward_arrow = ${ ("<-[" ~ scale_val ~ "]-") | "<-" }
arrow          = { forward_arrow | backward_arrow }

// ─── Tap targets (ADR 0054) ──────────────────────────────────────────────────
// Cable RHS form: `~taptype(name, k: v, ...)` and compound `~a+b+c(name, ...)`.
// Component set is closed and grammar-enforced so unknown components fail with
// a parse-level diagnostic at the `~` site.
// Open ident; the closed component set is enforced at validate-time so
// the structural diagnostic can suggest valid alternatives (ticket 0711).
tap_component  = { ident }
tap_components = { tap_component ~ ("+" ~ tap_component)* }
tap_target     = { "~" ~ tap_components ~ "(" ~ ident ~ ")" }

// ─── Host control declarations (ADR 0057, Amendment 2026-04-30) ─────────────
// `kind name { field: value, ... }` declared at top-level patch scope.
// kind ∈ { knob, slider, toggle }. Word-boundary lookahead so identifiers
// like `knob_count` are not consumed as the keyword.
host_control_kind  = @{ ("knob" | "slider" | "toggle" | "trigger") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
host_control_field = { ident ~ ":" ~ value }
host_control_block = { host_control_kind ~ ident ~ "{" ~ (host_control_field ~ ","?)* ~ "}" }

// `~name` reference to a declared host control, used in cable endpoints.
// The leading `~` mirrors tap targets (ADR 0054 §2 reserves `~` for
// expander-synthesised names, of which the host-control synth instance
// is one). Compound-atomic; tap_target is tried first in cable_endpoint
// so `~name(...)` parses as a tap, `~name` falls through here.
host_control_ref = ${ "~" ~ ident }

// ─── Connections ──────────────────────────────────────────────────────────────
// A cable endpoint is a port reference, a tap target, or a `~name`
// host-control reference (resolved at expand time). tap_target must come
// first so `~comp(name)` parses as a tap before host_control_ref's
// `~name` form would otherwise consume the ident.
cable_endpoint = { tap_target | host_control_ref | port_ref }
// Fan-out / fan-in: lists allowed on either side of the arrow. Forward
// (`->`) lists fan out from a single source on the LHS; backward (`<-`)
// lists fan in to a single source on the RHS. The builder rejects lists
// on the side opposite the arrow direction.
connection = { cable_endpoint ~ ("," ~ cable_endpoint)* ~ arrow
              ~ cable_endpoint ~ ("," ~ cable_endpoint)* }

// ─── Statements ───────────────────────────────────────────────────────────────
statement = { module_decl | song_block | pattern_block | host_control_block | connection }

// ─── Port declarations (inside templates) ────────────────────────────────────
// Port group declarations support optional arity: `audio[n]` or plain `freq`.
port_group_decl  = { ident ~ ("[" ~ ident ~ "]")? }
comma_port_decls = { port_group_decl ~ ("," ~ port_group_decl)* ~ ","? }
in_decl      = { "in:" ~ comma_port_decls }
out_decl     = { "out:" ~ comma_port_decls }
port_decls   = { in_decl? ~ out_decl }

// ─── Template parameter declarations ─────────────────────────────────────────
type_name   = { "float" | "int" | "bool" | "pattern" | "song" | "str" }
// param_decl supports optional arity: `level[size]: float = 1.0` or `freq: float`
param_decl  = { ident ~ ("[" ~ ident ~ "]")? ~ ":" ~ type_name ~ ("=" ~ scalar)? }
param_decls = { "(" ~ (param_decl ~ ","?)* ~ ")" }

// ─── Template ─────────────────────────────────────────────────────────────────
template = { "template" ~ ident ~ param_decls? ~ "{" ~ port_decls ~ statement* ~ "}" }

// ─── Patch ────────────────────────────────────────────────────────────────────
patch = { "patch" ~ "{" ~ statement* ~ "}" }

// ─── Step notation (inside pattern channel rows) ─────────────────────────────
// ADR 0077 unified grammar (ticket 0946). Eight cell shapes:
//   .            rest
//   _            tie / continuation (channel-stateful: sustain, absorbed,
//                  or slide-flow depending on the open modifier)
//   value        triggered note (`value`, `value:cv2`, `value*N`)
//   value>value  one-tick slide sugar (legacy form)
//   value>       open a multi-tick slide (no close target — supplied later)
//   /value       change cv1 (and optionally cv2) without retrigger
//   >_           explicit slide-flow / open-from-current cv
//   >value       close an open slide within this tick (no trigger)
//
// The `~` tie token from epic E152 has been retired in favour of `_`
// (ADR 0077 § "Token ambiguity"). The `~tap(...)` / `~name`
// cable-endpoint forms are unaffected.
//
// Trailing word-boundary lookaheads on the single-char tokens prevent
// `_foo` / `.5` / etc. from accidentally matching.
step_note     = @{ note_letter ~ note_accidental? ~ note_octave }
step_trigger  = @{ "x" ~ !(ASCII_ALPHANUMERIC | "_") }
step_rest     = @{ "." }
step_tie      = @{ "_" ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
step_float    = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* }
step_int      = @{ "-"? ~ ASCII_DIGIT+ }
step_unit     = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? ~ unit_suffix }

// Slide target: ">value" where value is a note, float, or unit literal.
// Used inside the `value>value` sugar form (`step_valued`).
step_slide_target = { ">" ~ (step_unit | step_note | step_float | step_int) }

// cv2 part: ":value" with optional slide ">value"
step_cv2      = { ":" ~ (step_unit | step_float | step_int) ~ step_slide_target? }

// Repeat suffix: "*N"
step_repeat   = ${ "*" ~ nat }

// A full valued step: cv1 (with optional one-tick slide sugar) + optional
// cv2 + optional repeat. Note: `/value` cannot carry `*N` (rejected at
// grammar level), so `step_repeat` lives only on `step_valued`.
step_valued   = { (step_unit | step_note | step_trigger | step_float | step_int) ~ step_slide_target? ~ step_cv2? ~ step_repeat? }

// New cell shapes (ADR 0077, extended by ticket 0948 to carry an
// optional `:cv2` tail on the three slide cells so cv2 can ramp
// through a slide alongside cv1).
//
// `step_tie_flow` is matched before `step_slide_close` so the `>_` form
// is not consumed as a `>` slide-close with leftover `_`.
//
// `step_cv2_tail` is the `:cv2` modifier that attaches to the three
// slide cells (open / step-to / close-in-tick). Uses the same primary
// set as `step_cv2` (no note literals).
step_tie_flow    = @{ ">_" ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
step_cv2_tail    = ${ ":" ~ (step_unit | step_float | step_int) }
step_step_to     = ${ "/" ~ (step_unit | step_note | step_float | step_int) ~ step_cv2_tail? }
step_slide_close = ${ ">" ~ (step_unit | step_note | step_float | step_int) ~ step_cv2_tail? }
// `value[:cv2]>` with no value after the `>`. The negative lookahead
// ensures the slide-open shape does not consume the head of a
// `value>value` sugar form (which falls through to `step_valued`).
step_slide_open  = ${ (step_unit | step_note | step_float | step_int) ~ step_cv2_tail? ~ ">" ~ !(step_unit | step_note | step_float | step_int) }

// Order: tie_flow before slide_close (both start with `>`); slide_open
// before step_valued (so `value>` is recognised as the open shape
// before step_valued's optional slide_target).
step             = { step_rest | step_tie_flow | step_step_to | step_slide_close | step_slide_open | step_tie | step_valued }

// ─── Pattern blocks ──────────────────────────────────────────────────────────
// A channel row: "label: step step ... [| continuation ...]"
// The trailing "|" continues the row on the next line.
//
// The `slide(n, A, B)` macro generator was removed in ticket 0948;
// authors write slides inline as `A> >_* >B` cells. The row builder
// in `patches-core::resolve_step_effects` resolves the multi-cell
// shape into a single continuous slide schedule.
channel_row_cont   = { "|" ~ step* }
channel_row        = { ident ~ ":" ~ step* ~ channel_row_cont* }
pattern_block      = { "pattern" ~ ident ~ "{" ~ channel_row+ ~ "}" }

// ─── Song composition (ADR 0035) ─────────────────────────────────────────────
// Lanes are declared in the song header. Song bodies contain `section`,
// `play`, `pattern`, and `@loop` items. `section`s hold row sequences; row
// sequences are newline-significant.
song_silence    = @{ "_" ~ !(ASCII_ALPHANUMERIC | "_" | "-") }

// Inline whitespace only (no newlines) — used inside compound-atomic rules.
iws             = _{ (" " | "\t" | ("#" ~ (!"\n" ~ ANY)*))+ }
// Whitespace that may include newlines (for inside parenthesised row groups).
aws             = _{ (" " | "\t" | ("#" ~ (!"\n" ~ ANY)*) | "\r" | "\n")* }
// Row separator: at least one newline, possibly interleaved with inline ws.
row_sep         = _{ (iws? ~ ("\r"? ~ "\n"))+ ~ (iws? ~ ("\r"? ~ "\n"))* ~ iws? }

// A cell. Compound-atomic so it sees no implicit whitespace; its children
// (song_silence/param_ref/ident) are themselves atomic or compound-atomic.
row_cell        = ${ song_silence | param_ref | ident }
// A row: at least one cell, separated by commas with optional inline ws.
song_row        = ${ row_cell ~ (iws? ~ "," ~ iws? ~ row_cell)* }
// A parenthesised repeatable group.
repeat_group    = ${ "(" ~ aws ~ row_seq ~ aws ~ ")" ~ iws? ~ "*" ~ iws? ~ nat }
// A row group: either a repeatable parenthesised group or a single row.
// repeat_group must come first so an initial "(" is not misread.
row_group       = ${ repeat_group | song_row }
// A row sequence: rows separated by one or more newlines.
row_seq         = ${ (iws? ~ ("\r"? ~ "\n"))* ~ iws? ~ row_group ~ (row_sep ~ row_group)* ~ (iws? ~ ("\r"? ~ "\n"))* ~ iws? }

// Section definitions. Allowed at file top level, inside songs, and inside
// templates/patches (as a statement — see `statement`).
section_def     = { "section" ~ ident ~ "{" ~ row_seq ~ "}" }

// Play composition.
play_atom_group = { "(" ~ play_expr ~ ")" }
play_atom       = { play_atom_group | ident }
play_term       = { play_atom ~ ("*" ~ nat)? }
play_expr       = { play_term ~ ("," ~ play_term)* }
inline_block    = { "{" ~ row_seq ~ "}" }
named_inline    = { ident ~ "{" ~ row_seq ~ "}" }
// Order: inline_block ("{...") before named_inline (ident "{...") before play_expr (ident-led).
play_body       = { inline_block | named_inline | play_expr }
play_stmt       = { "play" ~ play_body }

loop_marker     = @{ "@loop" ~ !(ASCII_ALPHANUMERIC | "_" | "-") }

// Song item: sections, patterns, play statements, and the loop marker.
song_item       = { section_def | pattern_block | play_stmt | loop_marker }
song_lanes      = { "(" ~ ident ~ ("," ~ ident)* ~ ")" }
song_block      = { "song" ~ ident ~ song_lanes ~ "{" ~ song_item* ~ "}" }

// ─── Include directives ──────────────────────────────────────────────────────
include_directive = { "include" ~ string_lit }

// ─── File root ────────────────────────────────────────────────────────────────
file         = { SOI ~ (include_directive | template | pattern_block | section_def | song_block)* ~ patch ~ EOI }
include_file = { SOI ~ (include_directive | template | pattern_block | section_def | song_block)* ~ EOI }
