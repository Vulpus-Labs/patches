# wurli.patches — Wurlitzer-style electric piano
#
# Two-operator FM: sine carrier modulated by a sibling sine one octave
# up, whose 2-sample rolling-average self-feedback gives the classic DX
# Wurli "bark" on attack. Without feedback this is a clean PM bell; with
# feedback the modulator's spectrum saws out for the first ~150 ms,
# stamping a reed-keybar bite on the front of every note before settling
# back to the underlying sine carrier.
#
# Tremolo (filter cutoff modulation via LFO) for the classic vibe.

patch {
    module kbd      : PolyMidiToCv

    # Modulator: +1 octave, fast envelope, self-feedback for the bark.
    module mod      : PolyOp {
        frequency: 1.0,
        attack: 0.004, decay: 0.10, sustain: 0.0, release: 0.15
    }
    # Carrier: sine at base pitch, medium-decay amp envelope.
    module car      : PolyOp {
        attack: 0.002, decay: 1.3, sustain: 0.0, release: 0.6
    }

    module lfo      : Lfo { rate: 5.5, mode: bipolar }
    module filt     : PolyLowpass { cutoff: 1.8kHz, resonance: 0.1 }

    module verb     : FdnReverb { character: room, size: 0.3, mix: 0.15 }
    module lim      : StereoLimiter { threshold: -3db }
    module out      : AudioOut

    kbd.voct        -> car.voct
    kbd.voct        -> mod.voct

    kbd.trigger     -> mod.trigger
    kbd.gate        -> mod.gate
    kbd.trigger     -> car.trigger
    kbd.gate        -> car.gate

    # Self-feedback on the modulator → DX-style keybar bark on attack.
    # The 1-sample cable delay is what makes this stable; the in-module
    # 2-sample rolling average tames runaway gain.
    mod.out      -[0.4]-> mod.feedback

    # Modulator drives carrier phase.
    mod.out      -[0.85]-> car.phase_mod

    car.out         -> filt.in
    lfo.sine     -[0.6]-> filt.fm

    filt.out -[0.15]-> verb.in
    verb.out        -> lim.in
    lim.out         -> out.in
}
